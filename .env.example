# Required
ANTHROPIC_API_KEY=sk-ant-...

# Email via Resend (recommended — https://resend.com)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=radar@yourdomain.com
EMAIL_TO=you@example.com

# Email via SMTP (alternative to Resend — set EMAIL_PROVIDER=smtp in config.yaml)
# Gmail: host=smtp.gmail.com, port=587, use an App Password (requires 2FA)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
